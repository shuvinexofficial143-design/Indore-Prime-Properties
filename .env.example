# Dedicated database only; TLS required for remote Neon.
DATABASE_URL=
# Exact public origin, e.g. https://your-preview.vercel.app
APP_ORIGIN=
# Set only locally for bootstrap; never commit or deploy bootstrap passwords.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=
MEDIA_STORAGE_URL=
AI_PROVIDER_API_KEY=
META_ACCESS_TOKEN=

# Optional private S3-compatible bucket (not provisioned automatically)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Meshy provider; disabled by default, only owner-triggered paid requests.
MESHY_API_KEY=
MESHY_GENERATION_ENABLED=
